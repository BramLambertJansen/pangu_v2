VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only (Vercel env vars, nooit VITE_ prefix — niet in de browser-bundle)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Zet op 'true' om alle CRUD lokaal (localStorage) uit te voeren i.p.v. Supabase.
# Handig voor testen zonder de database te raken. Nooit 'true' in productie.
VITE_DEV_MODE=false
