# Local secrets for testing the ai-chat edge function.
# Copy to .env.local and fill in your actual keys — never commit .env.local to git.
#
# Usage: supabase functions serve ai-chat --env-file supabase/functions/ai-chat/.env.local

GROQ_API_KEY=your-groq-key-here
GEMINI_API_KEY=your-gemini-key-here

# These are auto-injected in production, but needed for local serve:
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-local-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key-here
